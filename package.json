{
  "name": "dsh-switch",
  "version": "1.7.0",
  "description": "Customizable switch buttons for the DSH Web GUI composer (one-click slash-command insertion into the draft, config stored in the Host settings document)",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/client.test.cjs",
    "install:dsh": "node install.mjs"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/cosmokit": "1.8.3",
    "@deepseek-ai/schemastery": "3.18.2",
    "@standard-schema/spec": "1.1.0",
    "dsh-switch": "file:dsh-switch-1.7.0.tgz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weimingyu9312/DSHSwitch.git"
  },
  "homepage": "https://github.com/weimingyu9312/DSHSwitch#readme",
  "bugs": {
    "url": "https://github.com/weimingyu9312/DSHSwitch/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
