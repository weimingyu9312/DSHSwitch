{
  "name": "dsh-switch",
  "version": "1.4.0",
  "description": "Customizable switch buttons for quick command execution in DSH Web GUI (toggle-command and one-click slash insert, config stored in the Host settings document)",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/client.test.cjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "license": "MIT"
}
