{
  "name": "dsh-switch",
  "version": "1.6.0",
  "description": "Customizable switch buttons for the DSH Web GUI composer (one-click slash-command insertion into the draft, config stored in the Host settings document)",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/client.test.cjs",
    "install:dsh": "node install.mjs"
  },
  "files": [
    "lib",
    "node_modules/@deepseek-ai/schemastery",
    "node_modules/@deepseek-ai/cosmokit",
    "node_modules/@standard-schema/spec",
    "cordis.patch.yml",
    "install.mjs",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "3.18.2",
    "@deepseek-ai/cosmokit": "1.8.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/schemastery": {
      "optional": true,
      "description": "Satisfied by the vendored tree under node_modules/; pin matches the DSH Desktop 0.8.2 host release."
    },
    "@deepseek-ai/cosmokit": {
      "optional": true,
      "description": "Transitive runtime dep of schemastery, also vendored; declared so removing the vendor tree is a visible decision, not a silent break."
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weimingyu9312/DSHSwitch.git"
  },
  "homepage": "https://github.com/weimingyu9312/DSHSwitch#readme",
  "bugs": {
    "url": "https://github.com/weimingyu9312/DSHSwitch/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "license": "MIT"
}
